{
  "version": 1,
  "session_selection": {
    "strategy": "weekday_then_alternate",
    "first_day_type": "first_plan_key",
    "weekday_day_types": {},
    "allow_explicit_session": true
  },
  "substitutions": {
    "max_per_session": 2,
    "allowed": []
  },
  "recovery": {
    "max_age_days": 1,
    "baseline_window_days": 28,
    "baseline_min_observed_days": 14,
    "allow_legacy_unscoped_baseline": false
  },
  "subjective": {
