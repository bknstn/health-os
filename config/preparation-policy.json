    "events": {
      "subjective.energy": {
        "field": "value",
        "minimum": 1,
        "maximum": 5,
        "adjustment": {
          "operator": "lte",
          "threshold": 2,
          "target_sets_delta": -1
        }
      },
      "subjective.soreness": {
        "field": "value",
        "minimum": 0,
        "maximum": 5,
        "adjustment": {
          "operator": "gte",
          "threshold": 4,
          "target_sets_delta": -1
        }
      },
      "subjective.pain": {
        "field": "value",
        "minimum": 0,
        "maximum": 10,
        "adjustment": null
      }
    }
  }
}
