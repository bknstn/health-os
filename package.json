{
  "name": "health-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local CLI for strength training logs, recovery decisions, and Oura synchronization.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bknstn/health-os.git"
  },
  "bin": {
    "health-os": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "health:status": "src/scripts/today.sh",
    "health:morning": "src/scripts/sync-daily-source.sh --source oura && src/scripts/today.sh",
    "health:next": "src/scripts/next-workout.sh",
    "health:weekly": "src/scripts/weekly-summary.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
