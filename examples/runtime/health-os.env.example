# health-os runtime example
# Copy this file outside the repo, fill the secrets, then source it before running the setup commands.

HEALTH_OS_ROOT=/absolute/path/to/health-os
HEALTH_OS_WORKSPACE=$HOME/.local/share/health-os/workspace

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8787/callback
OURA_TOKEN_FILE=$HOME/.config/health-os/oura-token.json
OURA_SCOPE="daily heartrate"
OURA_CALLBACK_HOST=127.0.0.1
OURA_CALLBACK_PORT=8787

OURA_API_BASE_URL=https://api.ouraring.com
OURA_READINESS_PATH=/v2/usercollection/daily_readiness
OURA_SLEEP_PATH=/v2/usercollection/daily_sleep
OURA_HEARTRATE_PATH=/v2/usercollection/heartrate
OURA_STRICT_HEARTRATE=false
